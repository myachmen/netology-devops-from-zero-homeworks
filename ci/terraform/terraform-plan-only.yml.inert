# TASK 159: non-discoverable template, NOT an active workflow.
# Separate owner approval required to copy/activate, configure inputs and dispatch.
name: Terraform plan only (UNACTIVATED TEMPLATE)
on:
  workflow_dispatch:
    inputs:
      approved_sha:
        description: Exact reviewed current main SHA (40 lowercase hex characters)
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: terraform-infrastructure-s3-default
  cancel-in-progress: false
jobs:
  plan:
    if: ${{ false && github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/diplom-yandexcloud' && github.repository == 'myachmen/netology-devops-from-zero-homeworks' && github.run_attempt == 1 }}
    runs-on: ubuntu-24.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - name: Offline policy and safety tests
        run: python3 -m unittest discover -s tests -p 'test_terraform_*.py' -v
      - uses: hashicorp/setup-terraform@b9cd54a3c349d3f38e8881555d616ced269862dd # v3
        with:
          terraform_version: 1.15.7
          terraform_wrapper: false
      - name: Future approved plan only
        env:
          TF_PLAN_ACTIVATION: OWNER_APPROVAL_REQUIRED
          TF_PLAN_APPROVED_SHA: ${{ inputs.approved_sha }}
          TF_YC_SERVICE_ACCOUNT_KEY_JSON: ${{ secrets.TF_YC_SERVICE_ACCOUNT_KEY_JSON }}
          TF_S3_ACCESS_KEY_ID: ${{ secrets.TF_S3_ACCESS_KEY_ID }}
          TF_S3_SECRET_ACCESS_KEY: ${{ secrets.TF_S3_SECRET_ACCESS_KEY }}
          TF_VAR_cloud_id: ${{ vars.TF_CLOUD_ID }}
          TF_VAR_folder_id: ${{ vars.TF_FOLDER_ID }}
          TF_VAR_admin_cidr: ${{ vars.TF_ADMIN_CIDR }}
          TF_SSH_PUBLIC_KEY: ${{ vars.TF_SSH_PUBLIC_KEY }}
          GITHUB_TOKEN: ${{ github.token }}
        run: python3 ci/terraform/run_plan_only.py
