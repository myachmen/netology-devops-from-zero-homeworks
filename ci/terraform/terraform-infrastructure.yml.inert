# TASK 156: TEMPLATE ONLY. GitHub does not discover workflows in this directory.
# Even if copied, BOTH jobs are disabled and activation input is unapproved.
# Activation requires separate owner approval, review and explicit edits below.
name: Terraform infrastructure (UNACTIVATED TEMPLATE)
on:
  pull_request:
    branches: [main]
    paths: ['terraform/infrastructure/**', 'ci/terraform/**', 'tests/test_terraform_*.py', '.github/workflows/terraform-infrastructure.yml']
  push:
    branches: [main]
permissions:
  contents: read
concurrency:
  group: terraform-infrastructure-s3-default
  cancel-in-progress: false
jobs:
  static:
    if: ${{ false && github.event_name == 'pull_request' }}
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - run: python3 -m unittest discover -s tests -p 'test_terraform_*.py' -v
      - uses: hashicorp/setup-terraform@b9cd54a3c349d3f38e8881555d616ced269862dd # v3
        with:
          terraform_version: 1.15.7
          terraform_wrapper: false
      - name: Isolated static Terraform checks (future authorization required)
        working-directory: terraform/infrastructure
        shell: bash
        run: |
          set -euo pipefail
          terraform fmt -check -recursive
          terraform init -backend=false -input=false -lockfile=readonly -no-color
          terraform validate -no-color
  infrastructure:
    if: ${{ false && github.event_name == 'push' && github.ref == 'refs/heads/diplom-yandexcloud' && github.repository == 'myachmen/netology-devops-from-zero-homeworks' }}
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - run: python3 -m unittest discover -s tests -p 'test_terraform_*.py' -v
      - uses: hashicorp/setup-terraform@b9cd54a3c349d3f38e8881555d616ced269862dd # v3
        with:
          terraform_version: 1.15.7
          terraform_wrapper: false
      - name: Future approved existing-noop-only execution
        env:
          TF_CI_ACTIVATION: OWNER_APPROVAL_REQUIRED
          TF_YC_SERVICE_ACCOUNT_KEY_JSON: ${{ secrets.TF_YC_SERVICE_ACCOUNT_KEY_JSON }}
          TF_S3_ACCESS_KEY_ID: ${{ secrets.TF_S3_ACCESS_KEY_ID }}
          TF_S3_SECRET_ACCESS_KEY: ${{ secrets.TF_S3_SECRET_ACCESS_KEY }}
          TF_VAR_cloud_id: ${{ vars.TF_CLOUD_ID }}
          TF_VAR_folder_id: ${{ vars.TF_FOLDER_ID }}
          TF_VAR_admin_cidr: ${{ vars.TF_ADMIN_CIDR }}
          TF_SSH_PUBLIC_KEY: ${{ vars.TF_SSH_PUBLIC_KEY }}
          GITHUB_TOKEN: ${{ github.token }}
        run: python3 ci/terraform/run_infrastructure.py
