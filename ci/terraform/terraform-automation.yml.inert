# Task179: copy to .github/workflows ONLY after owner gate. Not active here.
name: Terraform automation
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
permissions:
  contents: read
concurrency:
  group: terraform-infrastructure-s3-default
  cancel-in-progress: false
jobs:
  offline:
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
      - name: Synthetic tests only
        # Test dependency only; no Terraform/backend or credentials in this job.
        # Installation happens on a FUTURE explicitly activated runner.
        # No dependencies are installed locally in task179.
        run: |
          python3 -m venv "$RUNNER_TEMP/tf-tests"
          "$RUNNER_TEMP/tf-tests/bin/python" -m pip install --disable-pip-version-check PyYAML==6.0.2
          "$RUNNER_TEMP/tf-tests/bin/python" -B -m unittest discover -s tests -p 'test_terraform_*.py' -v
  plan:
    needs: offline
    if: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' && vars.TF_AUTOMATION_MODE == 'plan' && github.run_attempt == 1 }}
    runs-on: ubuntu-24.04
    timeout-minutes: 25
    environment: terraform-plan
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: hashicorp/setup-terraform@b9cd54a3c349d3f38e8881555d616ced269862dd
        with:
          terraform_version: 1.15.7
          terraform_wrapper: false
      - name: Install pinned S3 SDK on future runner
        run: |
          python3 -m venv "$RUNNER_TEMP/tf-sdk"
          "$RUNNER_TEMP/tf-sdk/bin/python" -m pip install --disable-pip-version-check boto3==1.43.124 botocore==1.43.124
      - name: Plan and redacted change summary
        env:
          TF_AUTOMATION_MODE: plan
          TF_YC_SERVICE_ACCOUNT_KEY_JSON: ${{ secrets.TF_YC_SERVICE_ACCOUNT_KEY_JSON }}
          TF_S3_ACCESS_KEY_ID: ${{ secrets.TF_S3_ACCESS_KEY_ID }}
          TF_S3_SECRET_ACCESS_KEY: ${{ secrets.TF_S3_SECRET_ACCESS_KEY }}
          TF_VAR_cloud_id: ${{ vars.TF_CLOUD_ID }}
          TF_VAR_folder_id: ${{ vars.TF_FOLDER_ID }}
          TF_VAR_admin_cidr: ${{ vars.TF_ADMIN_CIDR }}
          TF_SSH_PUBLIC_KEY: ${{ vars.TF_SSH_PUBLIC_KEY }}
          GITHUB_TOKEN: ${{ github.token }}
        run: '"$RUNNER_TEMP/tf-sdk/bin/python" -B ci/terraform/run_automation.py plan >> "$GITHUB_STEP_SUMMARY"'
  apply:
    needs: offline
    if: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' && vars.TF_AUTOMATION_MODE == 'apply' && github.run_attempt == 1 }}
    runs-on: ubuntu-24.04
    timeout-minutes: 40
    environment: terraform-production
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: hashicorp/setup-terraform@b9cd54a3c349d3f38e8881555d616ced269862dd
        with:
          terraform_version: 1.15.7
          terraform_wrapper: false
      - name: Install pinned S3 SDK on future runner
        run: |
          python3 -m venv "$RUNNER_TEMP/tf-sdk"
          "$RUNNER_TEMP/tf-sdk/bin/python" -m pip install --disable-pip-version-check boto3==1.43.124 botocore==1.43.124
      - name: Fresh plan and exact approved saved-plan apply
        env:
          TF_AUTOMATION_MODE: apply
          TF_APPROVED_APPLY_SHA: ${{ vars.TF_APPROVED_APPLY_SHA }}
          TF_APPROVED_CHANGE_SHA256: ${{ vars.TF_APPROVED_CHANGE_SHA256 }}
          TF_YC_SERVICE_ACCOUNT_KEY_JSON: ${{ secrets.TF_YC_SERVICE_ACCOUNT_KEY_JSON }}
          TF_S3_ACCESS_KEY_ID: ${{ secrets.TF_S3_ACCESS_KEY_ID }}
          TF_S3_SECRET_ACCESS_KEY: ${{ secrets.TF_S3_SECRET_ACCESS_KEY }}
          TF_VAR_cloud_id: ${{ vars.TF_CLOUD_ID }}
          TF_VAR_folder_id: ${{ vars.TF_FOLDER_ID }}
          TF_VAR_admin_cidr: ${{ vars.TF_ADMIN_CIDR }}
          TF_SSH_PUBLIC_KEY: ${{ vars.TF_SSH_PUBLIC_KEY }}
          GITHUB_TOKEN: ${{ github.token }}
        run: '"$RUNNER_TEMP/tf-sdk/bin/python" -B ci/terraform/run_automation.py apply >> "$GITHUB_STEP_SUMMARY"'
