# Terraform working directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variables (may contain secrets)
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Terraform plan files
*.tfplan
tfplan
tfplan.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Credentials and private keys
*.pem
*.key
*.p12
*.pfx
credentials.json
authorized_key.json

# Environment files
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc

# Local IDE settings
.vscode/
.idea/

# Vagrant
.vagrant/