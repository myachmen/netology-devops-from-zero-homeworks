Host k8s-control-1
    HostName <CONTROL_PLANE_PUBLIC_IP>
    User ubuntu
    IdentitiesOnly no

Host k8s-worker-1
    HostName 10.10.2.28
    User ubuntu
    IdentitiesOnly no
    ProxyJump k8s-control-1

Host k8s-worker-2
    HostName 10.10.2.34
    User ubuntu
    IdentitiesOnly no
    ProxyJump k8s-control-1
